# ==================================================
# LaTeX 補助ファイル
# ==================================================

# 基本的な補助ファイル
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk

# 参考文献関連
*.bbl
*.bcf
*.blg
*.run.xml
*.biber.*

# 索引・用語集関連（glossaries-extra + bib2gls）
*.acn
*.acr
*.alg
*.set
*.sto
*.slg
*.ind
*.ino
*.ilg
*.var
*.vro
*.vrg
*.par
*.pro
*.prg
*.glstex
*.glg

# SyncTeX（PDF-TeX間ジャンプ用）
# ビルド環境のローカル絶対パスを含むため，Git管理対象外とする
*.synctex.gz

# その他のLaTeX関連
*.dvi
*.xdv
*.ps
*.nav
*.snm
*.vrb
*-blx.aux
*-blx.bib
*.brf

# LuaTeX キャッシュディレクトリ
.texmf-cache/

# ==================================================
# エディタ・OS関連
# ==================================================

# VS Code
.vscode/*
!.vscode/settings.json

# Claude Code
.claude/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory

# ==================================================
# 出力ディレクトリ
# ==================================================

# ビルド出力ディレクトリ
# buildディレクトリをGitで管理するため，コメントアウト
# build/

# ==================================================
# 出力ファイル（必要に応じて管理）
# ==================================================

# PDFファイル管理設定
# buildディレクトリのPDFはGitで管理される（*.log等の補助ファイルは除外される）
# 他のPDFファイル（図表，文書類）も管理対象として含める

# ==================================================
# バックアップ・一時ファイル
# ==================================================
*.bak
*.backup
*.tmp
*.temp
*.swp
*.swo
